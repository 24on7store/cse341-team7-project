<%- include('../partials/header') %>
<h1>Explore Our Scenic Rail Trips</h1>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
        <option value="kanto">Kanto</option>
        <option value="kansai">Kansai</option>
        <option value="chubu">Chubu</option>
        <option value="hokkaido">Hokkaido</option>
        <option value="kyushu">Kyushu</option>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
        <option value="spring">Spring</option>
        <option value="summer">Summer</option>
        <option value="autumn">Autumn</option>
        <option value="winter">Winter</option>
    </select>
</div>

<div class="trips-state" id="trips-loading">Loading available trips...</div>
<div class="trips-state trips-error" id="trips-error" hidden></div>

<!-- Target injection element where frontend JS will append items -->
<div class="routes-grid" id="trips-list"></div>

<!-- The reusable blueprint template matching your team's precise CSS classes -->
<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="start-station"></div>
            </div>
            <div class="route-arrow">→</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">🕑</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">📍</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge" data-field="season-badge"></span>
            </div>
        </div>

        <div class="route-description" data-field="description"></div>

        <div class="highlights">
            <div class="highlights-list" data-field="highlights-container">
                <!-- Javascript will dynamically append highlight-tag spans here -->
            </div>
        </div>
            
        <div class="route-actions">
            <a href="#" class="view-details-btn" data-field="link">
                View Details &amp; Book →
            </a>
        </div>
    </div>
</template>

<script src="/js/trips-list.js" defer></script>

<%- include('../partials/footer') %>
