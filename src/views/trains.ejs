<%- include('./partials/header') %>

<section class="trains-hero">
    <h1>Learn about our Trains</h1>
    <p>
        Explore the physical trains that power scenic the trips across the Kizuna Rail network.
    </p>
</section>

<section class="trains-catalog">
    <div class="trains-controls">
        <div class="trains-search">
            <label for="trains-search">Search trains</label>
            <input
                type="search"
                id="trains-search"
                name="q"
                placeholder="Search by name, operator, type..."
            >
            <button type="button" id="trains-search-button">
                Search
            </button>
        </div>

        <div class="trains-sort">
            <label for="trains-sort">Sort by</label>
            <select id="trains-sort" name="sort">
                <option value="">Default</option>
                <option value="name">Name</option>
                <option value="operator">Operator</option>
                <option value="type">Type</option>
                <option value="maxSpeedKmh">Top Speed</option>
                <option value="capacity">Capacity</option>
                <option value="powerSource">Power Source</option>
            </select>

            <label for="trains-order">Order</label>
            <select id="trains-order" name="order">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>
    </div>

    <div class="trains-state" id="trains-loading">Loading trains...</div>

    <div class="trains-state trains-error" id="trains-error" hidden></div>

    <div class="trains-grid" id="trains-list"></div>

    <div class="trains-pagination" id="trains-pagination" hidden>
        <button type="button" id="trains-prev" disabled>
            Previous
        </button>

        <span id="trains-page-info">Page 1</span>

        <button type="button" id="trains-next" disabled>
            Next
        </button>
    </div>

    <template id="train-card-template">
        <article class="train-card">
            <div class="train-image-wrap">
                <img data-field="image" loading="lazy" decoding="async">
            </div>

            <header class="train-card-header">
                <h2 data-field="name"></h2>
                <span class="train-operator" data-field="operator"></span>
            </header>

            <p class="train-description" data-field="description"></p>

            <dl class="train-specs">
                <div class="spec-item">
                    <dt>Type</dt>
                    <dd data-field="type"></dd>
                </div>
                <div class="spec-item">
                    <dt>Top Speed</dt>
                    <dd data-field="speed"></dd>
                </div>
                <div class="spec-item">
                    <dt>Capacity</dt>
                    <dd data-field="seats"></dd>
                </div>
                <div class="spec-item">
                    <dt>Power</dt>
                    <dd data-field="power"></dd>
                </div>
            </dl>
            <p class="train-best-for">
                <strong>Best For:</strong>
                <span data-field="best-for"></span>
            </p>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
