<%- include('./partials/header') %>

<section class="bookings-hero">
    <h1>Bookings Administration</h1>
    <p>
        View bookings submitted through the Kizuna Rail booking system.
    </p>
</section>

<section class="bookings-catalog">
    <div class="bookings-state" id="bookings-loading">
        Loading bookings...
    </div>

    <div class="bookings-state bookings-error" id="bookings-error" hidden></div>

    <div class="bookings-state" id="bookings-empty" hidden>
        No bookings have been created yet.
    </div>

    <div class="bookings-grid" id="bookings-list"></div>

    <template id="booking-card-template">
        <article class="booking-card">
            <header class="booking-card-header">
                <h2>
                    Booking <span data-field="id"></span>
                </h2>
                <span class="booking-ticket-class" data-field="ticketClass"></span>
            </header>

            <dl class="booking-details">
                <div>
                    <dt>Schedule</dt>
                    <dd data-field="scheduleId"></dd>
                </div>

                <div>
                    <dt>Trip</dt>
                    <dd data-field="tripId"></dd>
                </div>

                <div>
                    <dt>Travel Day</dt>
                    <dd data-field="selectedDay"></dd>
                </div>

                <div>
                    <dt>Created</dt>
                    <dd data-field="createdAt"></dd>
                </div>
            </dl>

            <div class="booking-passengers">
                <h3>Passengers</h3>
                <ul data-field="passengers"></ul>
            </div>
            <div class="booking-actions">
                <button type="button" data-action="edit">Edit</button>
                <button type="button" data-action="delete">Delete</button>
            </div>

            <form class="booking-edit-form" data-field="edit-form" hidden>
                <label>
                    Schedule ID
                    <input type="number" data-field="edit-scheduleId" required>
                </label>

                <label>
                    Trip ID
                    <input type="text" data-field="edit-tripId" required>
                </label>

                <label>
                    Ticket Class
                    <input type="text" data-field="edit-ticketClass" required>
                </label>

                <label>
                    Travel Day
                    <input type="text" data-field="edit-selectedDay" required>
                </label>
                
            <div class="booking-edit-actions">
                <button type="submit">Save Changes</button>
                <button type="button" data-action="cancel-edit">Cancel</button>
            </div>
            </form>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
