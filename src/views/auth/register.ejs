<%- include('../partials/header') %>

    <section class="auth-page content">
        <header class="auth-page__header">
            <h1>Create an Account</h1>
            <p>Join Kizuna Rail to manage your trips and bookings.</p>
        </header>

        <% if (typeof error !=='undefined' ) { %>
            <p class="auth-page__error" role="alert">
                <%= error %>
            </p>
            <% } %>

                <form class="auth-page__form" action="/auth/register" method="POST">
                    <label class="auth-page__field" for="displayName">
                        Display Name
                        <input type="text" id="displayName" name="displayName"
                            value="<%= formData?.displayName || '' %>" required>
                    </label>

                    <label class="auth-page__field" for="username">
                        Username
                        <input type="text" id="username" name="username" value="<%= formData?.username || '' %>"
                            required>
                    </label>

                    <label class="auth-page__field" for="email">
                        Email
                        <input type="email" id="email" name="email" value="<%= formData?.email || '' %>" required>
                    </label>

                    <label class="auth-page__field" for="password">
                        Password
                        <input type="password" id="password" name="password" required>
                    </label>

                    <button class="auth-page__submit" type="submit">Register</button>
                </form>

                <p class="auth-page__switch">Already have an account? <a href="/auth/login">Log in</a></p>
    </section>

    <%- include('../partials/footer') %>