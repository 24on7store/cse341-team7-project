<%- include('../partials/header') %>

    <section class="auth-page content">
        <header class="auth-page__header">
            <h1>Log In</h1>
            <p>Sign in to manage your Kizuna Rail account.</p>
        </header>

        <% if (typeof error !=='undefined' ) { %>
            <p class="auth-page__error" role="alert">
                <%= error %>
            </p>
            <% } %>

                <form class="auth-page__form" action="/auth/login" method="POST">
                    <label class="auth-page__field" for="username">
                        Username
                        <input type="text" id="username" name="username" value="<%= username || '' %>" required>
                    </label>

                    <label class="auth-page__field" for="password">
                        Password
                        <input type="password" id="password" name="password" required>
                    </label>

                    <button class="auth-page__submit" type="submit">Log In</button>
                </form>

                <p class="auth-page__switch">Don't have an account? <a href="/auth/register">Create an account</a></p>
    </section>

    <%- include('../partials/footer') %>