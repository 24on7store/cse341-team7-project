<%- include('partials/header') %>

    <section class="admin-dashboard content">
        <header class="admin-dashboard__hero">
            <p class="admin-dashboard__eyebrow">Kizuna Rail operations</p>
            <h1>Admin Dashboard</h1>
            <p>Keep bookings and user accounts organized from one place.</p>
        </header>

        <section aria-labelledby="admin-tools-heading">
            <h2 id="admin-tools-heading" class="admin-dashboard__section-title">Management tools</h2>

            <div class="admin-dashboard__grid">
                <article class="admin-dashboard__card">
                    <h3>Bookings</h3>
                    <p>Review, update, and remove passenger bookings.</p>
                    <a class="admin-dashboard__card-link" href="/bookings-admin">Manage bookings</a>
                </article>

                <article class="admin-dashboard__card">
                    <h3>Users</h3>
                    <p>Manage account details and access roles securely.</p>
                    <a class="admin-dashboard__card-link admin-dashboard__card-link--secondary"
                        href="/users-admin">Manage users</a>
                </article>
            </div>
        </section>

        <a class="admin-dashboard__back-link" href="/">Return to home</a>
    </section>

    <%- include('partials/footer') %>